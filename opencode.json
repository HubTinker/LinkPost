{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "amvera": {
      "type": "http",
      "url": "https://openmcp.msk0.amvera.ru/mcp",
      "headers": {
        "Authorization": "Bearer ${AMVERA_TOKEN}"
      }
    }
  }
}
